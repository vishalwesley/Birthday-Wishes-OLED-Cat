const unsigned char* frames[] = {
  cat_happy,
  cat_wink
};

const int numFrames = 2;
int frame = 0;

void setup() {
  I2Ccat.begin(8, 9);      // SDA, SCL
  I2Ctext.begin(21, 47);   // SDA, SCL

  if (!catDisplay.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (1);
  }

  if (!textDisplay.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    while (1);
  }

  catDisplay.clearDisplay();
  textDisplay.clearDisplay();
}

void loop() {

  // -------- CAT DISPLAY --------
  catDisplay.clearDisplay();

  catDisplay.drawBitmap(
    0,
    0,
    frames[frame],
    128,
    64,
    WHITE
  );

  catDisplay.display();

  frame++;
  if (frame >= numFrames)
    frame = 0;


  // -------- TEXT DISPLAY --------
static int msg = 0;

textDisplay.clearDisplay();
textDisplay.setTextColor(WHITE);

if (msg == 0) {
  textDisplay.setTextSize(2);
  textDisplay.setCursor(0, 25);
  textDisplay.println("THANK YOU!");
}
else if (msg == 1) {
  textDisplay.setTextSize(1);
  textDisplay.setCursor(25, 20);
  textDisplay.println("YOU MADE");
  textDisplay.setCursor(35, 38);
  textDisplay.println("MY DAY");
}
else {
  textDisplay.setTextSize(1);
  textDisplay.setCursor(45, 20);
  textDisplay.println("LOVE");
  textDisplay.setCursor(35, 38);
  textDisplay.println("Y'ALL");
}

textDisplay.display();

msg++;
if (msg > 2)
  msg = 0;

delay(1500);
}